# Source archive in the ESP32 "source" partition (bridge LLD R2.3 step 6): keep it small.
# git archive reads this file from the archived commit, so it takes effect once committed.
docs/design/stitch/** export-ignore
*.png export-ignore
# Third-party datasheets (PDF, available online) stay in git but not in the tank's source archive (design-notes §103).
docs/hardware/datasheets/** export-ignore
# The implementation plans are history (with their full diffs): in git, not in the tank's source archive.
docs/superpowers/plans/** export-ignore
# uv's lock files (~295 KB, regenerated by `uv sync` from each pyproject.toml) stay in git but not in the tank's
# source archive: with Spec 10's three plans the archive no longer fit the partition (design-notes §231).
**/uv.lock export-ignore
